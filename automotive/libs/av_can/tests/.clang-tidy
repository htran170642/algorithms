# Test-only overrides. Everything else is inherited from the root .clang-tidy.
# Kept identical to libs/av_conc/tests/.clang-tidy so the rule for test code is
# one rule, not a per-directory negotiation.
#
# bugprone-unchecked-optional-access cannot see through GoogleTest's assertion
# macros: after `ASSERT_TRUE(x.has_value())` it still reports the following
# `x.value()` as unchecked. The check stays enabled for library and app code,
# where it is the one that would catch a real nullopt dereference.
#
# readability-function-cognitive-complexity measures the *expanded* TestBody.
# Every EXPECT_ macro becomes a branch, and a lambda passed to std::thread adds
# a nesting multiplier on top, so a short and perfectly clear test can score
# above 25. The check stays at 25 where the number means what it says.
#
# cppcoreguidelines-macro-usage and -avoid-do-while: a test that must skip
# itself has to expand to `GTEST_SKIP() << ...; return;` at the call site. A
# function cannot do that -- returning from a helper returns from the helper.
# The `do { } while (false)` wrapper is the standard way to make such a macro
# behave like a single statement. Both checks are right in general and
# inapplicable here.

InheritParentConfig: true

Checks: >
  -bugprone-unchecked-optional-access,
  -cppcoreguidelines-macro-usage,
  -cppcoreguidelines-avoid-do-while

CheckOptions:
  - key: readability-function-cognitive-complexity.Threshold
    value: '50'
