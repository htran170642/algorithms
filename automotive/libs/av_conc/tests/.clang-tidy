# Test-only overrides. Everything else is inherited from the root .clang-tidy.
#
# bugprone-unchecked-optional-access cannot see through GoogleTest's assertion
# macros: after `ASSERT_TRUE(x.has_value())` it still reports the following
# `x.value()` as unchecked.
#
# readability-function-cognitive-complexity measures the *expanded* TestBody.
# Every EXPECT_ macro becomes a branch, and a lambda passed to std::thread adds
# a nesting multiplier on top, so a fourteen-line test that reads perfectly
# clearly scores 30. The check stays at 25 for library and app code, where the
# number means what it says.

InheritParentConfig: true

Checks: >
  -bugprone-unchecked-optional-access

CheckOptions:
  - key: readability-function-cognitive-complexity.Threshold
    value: '50'
